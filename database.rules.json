{
  "rules": {
    "meta_learn": {
      "byMode": {
        "$mode": {
          "comp": {
            ".read": "auth != null",
            ".write": "auth != null",
            "$type": {
              "n": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
              "s": { ".validate": "newData.isNumber() && newData.val() >= -1000000 && newData.val() <= 1000000" }
            }
          }
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && ($uid === auth.uid || root.child('users').child(auth.uid).child('friends').child($uid).val() === true)",
        // The charset must admit "-": the app seeds an anonymous player's profile as
        // `Guest-<uid4>`, and because that profile is written as one multi-path update,
        // this single .validate failing threw away the WHOLE update -- username, presence,
        // friends and history. Every guest session was silently profile-less. A hyphen is
        // safe in an RTDB key (unlike . # $ [ ] /), and usernameLower is used as one.
        "username":        { ".read": "auth != null", ".write": "auth != null && $uid === auth.uid", ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 16 && newData.val().matches(/^[a-zA-Z0-9_-]+$/)" },
        "usernameLower":   { ".write": "auth != null && $uid === auth.uid", ".validate": "newData.isString() && newData.val().length <= 16" },
        "photoURL":        { ".read": "auth != null", ".write": "auth != null && $uid === auth.uid", ".validate": "newData.isString() && newData.val().length <= 512" },
        "online":          { ".read": "auth != null", ".write": "auth != null && $uid === auth.uid" },
        "currentGame":     { ".read": "auth != null", ".write": "auth != null && $uid === auth.uid" },
        // SERVER-ONLY. Was self-writable with no validate, so any signed-in user (a guest included) could
        // set their own rating to anything from the console without playing a game. The Admin SDK
        // bypasses rules, so Cloud Functions remain the only writer; a client-host fallback no longer
        // writes it and pruneStale's repair sweep heals the gap.
        "rating":          { ".read": "auth != null", ".write": false },
        "createdAt":       { ".write": "auth != null && $uid === auth.uid && !data.exists()" },
        "ultimateBotWins": { ".write": "auth != null && $uid === auth.uid", ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000 && (!data.exists() ? newData.val() <= 1 : newData.val() === data.val() + 1)" },
        "history": {
          ".write": "auth != null && $uid === auth.uid",
          "$code": {
            ".write": "auth != null && ($uid === auth.uid || root.child('games').child($code).child('meta/hostUid').val() === auth.uid)"
          }
        },
        "appliedGames": {
          "$code": { ".write": "auth != null && $uid === auth.uid" }
        },
        "typeAff": {
          ".write": "auth != null && $uid === auth.uid",
          "$type": { ".validate": "newData.isNumber() && newData.val() >= 0" }
        },
        "ghost": { ".write": "auth != null && $uid === auth.uid" },
        "friends": {
          "$fid": {
            ".write": "auth != null && ($uid === auth.uid || ($fid === auth.uid && root.child('users').child(auth.uid).child('friends').child($uid).val() === true))"
          }
        },
        "invites": {
          "$code": {
            ".write": "auth != null && (root.child('users').child($uid).child('friends').child(auth.uid).exists() || (!newData.exists() && $uid === auth.uid))"
          }
        },
        "$other": { ".write": false }
      }
    },
    "usernames": {
      "$lower": {
        ".read": "auth != null",
        ".write": "auth != null && ((newData.exists() && newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid)) || (!newData.exists() && data.val() === auth.uid))"
      }
    },
    "leaderboard": {
      // SERVER-ONLY for the same reason as users/$uid/rating: a self-write with no validate let anyone
      // publish an arbitrary rating, username and photoURL to the public board.
      ".read": "auth != null",
      ".indexOn": ["rating"],
      "$uid": {
        ".write": false
      }
    },
    "priv": {
      "$code": {
        "$uid": {
          ".read": "auth != null && $uid === auth.uid",
          ".write": "auth != null && $uid === auth.uid"
        }
      }
    },
    "lobbies": {
      ".read": "auth != null",
      ".indexOn": ["createdAt"],
      "$code": {
        ".write": "auth != null && (root.child('games').child($code).child('meta/hostUid').val() === auth.uid || (!newData.exists() && !root.child('games').child($code).exists()))",
        "host":    { ".validate": "newData.isString() && newData.val().length <= 24" },
        "players": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8" },
        "max":     { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 8" }
      }
    },
    "games": {
      "$code": {
        ".read": "auth != null",
        ".indexOn": ["updatedAt"],
        ".write": "auth != null && (!data.exists() || (!newData.exists() && data.child('meta/hostUid').val() === auth.uid))",

        "meta": {
          // The takeover branch additionally requires the claimant to be a player in this game. Without
          // that check ANY signed-in user could seize host of any game whose heartbeat was >3s stale —
          // which, since hostBeat only refreshes at phase transitions, is most of the time — and then write
          // combat, placements and rating claims.
          ".write": "auth != null && (!data.parent().child('meta/hostUid').exists() || data.parent().child('meta/hostUid').val() === auth.uid || (newData.child('hostUid').val() === auth.uid && data.parent().child('players').child(auth.uid).exists() && (!data.child('hostBeat').exists() || data.child('hostBeat').val() < now - 3000)))",
          "phase": { ".validate": "newData.val().matches(/^(lobby|planning|combat|carousel|over)$/)" },
          "stage": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50" },
          "round": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 12" }
        },

        "rated": {
          "$uid": {
            ".write": "auth != null && root.child('games').child($code).child('meta/hostUid').val() === auth.uid"
          }
        },

        "ratingFailures": {
          "$uid": {
            ".write": "auth != null && root.child('games').child($code).child('meta/hostUid').val() === auth.uid"
          }
        },

        "results": {
          "$uid": {
            ".write": "auth != null && root.child('games').child($code).child('meta/hostUid').val() === auth.uid"
          }
        },

        "invited":  { ".write": "auth != null && (root.child('games').child($code).child('players').child(auth.uid).exists() || !newData.exists())" },
        "combat":   { ".write": "auth != null && (!root.child('games').child($code).child('meta/hostUid').exists() || root.child('games').child($code).child('meta/hostUid').val() === auth.uid)" },
        "carousel": { ".write": "auth != null && (!root.child('games').child($code).child('meta/hostUid').exists() || root.child('games').child($code).child('meta/hostUid').val() === auth.uid)" },
        "rules":    { ".write": "auth != null && (!root.child('games').child($code).child('meta/hostUid').exists() || root.child('games').child($code).child('meta/hostUid').val() === auth.uid)" },
        "teams":    { ".write": "auth != null && (!root.child('games').child($code).child('meta/hostUid').exists() || root.child('games').child($code).child('meta/hostUid').val() === auth.uid)",
          "$tid": { "hp": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500" } } },
        "ghost":    { ".write": "auth != null && (!root.child('games').child($code).child('meta/hostUid').exists() || root.child('games').child($code).child('meta/hostUid').val() === auth.uid)" },
        "transfers": {
          ".write": "auth != null && (!root.child('games').child($code).child('meta/hostUid').exists() || root.child('games').child($code).child('meta/hostUid').val() === auth.uid)",
          "$toUid": {
            ".read": "auth != null && $toUid === auth.uid",
            "$tid": {
              ".write": "auth != null && ((!newData.exists() && $toUid === auth.uid) || (newData.exists() && auth.uid !== $toUid && root.child('games').child($code).child('players').child(auth.uid).child('teamId').isNumber() && root.child('games').child($code).child('players').child(auth.uid).child('teamId').val() === root.child('games').child($code).child('players').child($toUid).child('teamId').val()))",
              ".validate": "newData.hasChild('kind') && newData.hasChild('from') && (!newData.hasChild('gold') || (newData.child('gold').isNumber() && newData.child('gold').val() >= 0 && newData.child('gold').val() <= 60))"
            }
          }
        },

        "nuzDead": {
          ".write": "auth != null && root.child('games').child($code).child('meta/hostUid').val() === auth.uid"
        },

        // Carousel rewards left for a player who was disconnected when the
        // timer ran out. The host writes them; the recipient applies the reward
        // in their own client and clears the row. Written per ROUND key rather
        // than a push id so a host retry overwrites instead of granting twice.
        //
        // The recipient's grant is deletion-only: if they could write it they
        // could hand themselves any item in the game.
        "grants": {
          "$uid": {
            "$gid": {
              ".write": "auth != null && (root.child('games').child($code).child('meta/hostUid').val() === auth.uid || ($uid === auth.uid && !newData.exists()))",
              ".validate": "newData.hasChildren(['pick','key'])",
              "pick": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64" },
              "key":  { ".validate": "newData.isString() && newData.val().length <= 12" },
              "ts":   { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          }
        },

        // Match chat. There was no rule here at all, which does NOT mean "open":
        // writes fell through to games/$code/.write, which only permits CREATING
        // a game or the host DELETING one -- so every message was refused, and
        // the client swallowed the error, so the feature looked present and had
        // never once delivered a message.
        //
        // What these rules do enforce:
        //   - only a player in THIS game may post (spectators read, cannot write)
        //   - uid is auth.uid, and name must equal the name on their own player
        //     node, so nobody can post under another trainer's banner
        //   - messages are write-once: no edits, no deleting what someone said.
        //     The whole games/$code node is removed by pruneStale, which is what
        //     bounds growth over time
        //   - 1..240 chars, and a timestamp within a few seconds of server time,
        //     so a message cannot be backdated to the top of the log
        //
        // What they do NOT enforce, deliberately stated: a per-second RATE limit.
        // Rules cannot count prior writes, and any scheme keyed on a companion
        // "last sent" node is bypassed by simply not writing that node. The
        // throttle is client-side. If chat flooding ever becomes a real problem
        // the fix is a Cloud Function relay, not a rule that reads like it is
        // protecting something and is not.
        "chat": {
          "$mid": {
            ".write": "auth != null && !data.exists() && root.child('games').child($code).child('players').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['uid','name','msg','t'])",
            "uid":  { ".validate": "newData.val() === auth.uid" },
            "name": { ".validate": "newData.isString() && newData.val() === root.child('games').child($code).child('players').child(auth.uid).child('name').val()" },
            "msg":  { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 240" },
            "t":    { ".validate": "newData.isNumber() && newData.val() >= now - 15000 && newData.val() <= now + 5000" },
            "$other": { ".validate": false }
          }
        },

        "players": {
          "$uid": {
            // A parent .write CASCADES to the whole subtree and a child rule cannot revoke it — so while this
            // node granted a blanket self-write, every per-field rule below (hp, alive, place, streak) was
            // dead code and a player could set their own HP to 500 or resurrect themselves. The self grant is
            // now deletion-only (leaving the game); each field is granted explicitly.
            // Three distinct self-grants, deliberately narrow:
            //   create  — joining writes the whole node in one set(), and a set() can only be
            //             authorised at the node or an ancestor. Gated to the lobby so a player
            //             cannot delete and re-create their node mid-match with inflated stats.
            //   delete  — leaving the game.
            // Anything else routes to the per-field rules below.
            ".write": "auth != null && (root.child('games').child($code).child('meta/hostUid').val() === auth.uid || ($uid === auth.uid && !data.exists() && root.child('games').child($code).child('meta/phase').val() === 'lobby') || ($uid === auth.uid && !newData.exists()))",
            "uid":       { ".write": "auth != null && ($uid === auth.uid && !data.exists())" },
            "name":  { ".write": "auth != null && ($uid === auth.uid || root.child('games').child($code).child('meta/hostUid').val() === auth.uid)", ".validate": "newData.isString() && newData.val().length <= 24" },
            "photoURL":  { ".write": "auth != null && ($uid === auth.uid || root.child('games').child($code).child('meta/hostUid').val() === auth.uid)" },
            "isHost":    { ".write": "auth != null && (($uid === auth.uid && !data.exists()) || root.child('games').child($code).child('meta/hostUid').val() === auth.uid)" },
            "connected": { ".write": "auth != null && ($uid === auth.uid || root.child('games').child($code).child('meta/hostUid').val() === auth.uid)" },
            "ready":     { ".write": "auth != null && ($uid === auth.uid || root.child('games').child($code).child('meta/hostUid').val() === auth.uid)" },
            "hp": {
              ".write": "auth != null && (root.child('games').child($code).child('meta/hostUid').val() === auth.uid || ($uid === auth.uid && newData.val() === 0))",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500"
            },
            "alive": {
              ".write": "auth != null && (root.child('games').child($code).child('meta/hostUid').val() === auth.uid || ($uid === auth.uid && newData.val() === false))"
            },
            "place": {
              ".write": "auth != null && root.child('games').child($code).child('meta/hostUid').val() === auth.uid",
              ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 1 && newData.val() <= 8)"
            },
            "streak": {
              ".write": "auth != null && root.child('games').child($code).child('meta/hostUid').val() === auth.uid",
              ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= -20 && newData.val() <= 20)"
            },
            "botMem": {
              ".write": "auth != null && root.child('games').child($code).child('meta/hostUid').val() === auth.uid",
              "$type": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10" }
            },
            "lastOpp": {
              ".write": "auth != null && root.child('games').child($code).child('meta/hostUid').val() === auth.uid",
              ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 32)"
            },
            "carouselPicked": {
              ".write": "auth != null && ($uid === auth.uid || root.child('games').child($code).child('meta/hostUid').val() === auth.uid)",
              ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 64)"
            },
            "level": { ".write": "auth != null && ($uid === auth.uid || root.child('games').child($code).child('meta/hostUid').val() === auth.uid)", ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10" },
            "gold":  { ".write": "auth != null && ($uid === auth.uid || root.child('games').child($code).child('meta/hostUid').val() === auth.uid)", ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 999)" },
            "board": { ".write": "auth != null && ($uid === auth.uid || root.child('games').child($code).child('meta/hostUid').val() === auth.uid)", ".validate": "!newData.exists() || !newData.hasChild('40')" },
            "bench": { ".write": "auth != null && ($uid === auth.uid || root.child('games').child($code).child('meta/hostUid').val() === auth.uid)", ".validate": "!newData.exists() || !newData.hasChild('40')" },
            "teamId": { ".write": "auth != null && ($uid === auth.uid || root.child('games').child($code).child('meta/hostUid').val() === auth.uid)", ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 4)" },
            "augments": {
              ".write": "auth != null && ($uid === auth.uid || root.child('games').child($code).child('meta/hostUid').val() === auth.uid)",
              ".validate": "!newData.exists() || !newData.hasChild('3')",
              "$i": { ".validate": "newData.isString() && newData.val().length <= 24" }
            },
            // isBot and botDifficulty are HOST-ONLY: they are read for control flow (bot boards are
            // host-generated, bots are excluded from the host pool and from the carousel-ready gate, and the
            // Functions refuse kickoff/concede for them), so a player who could set isBot on themselves got a
            // free host-drafted board every round.
            "isBot": { ".write": "auth != null && root.child('games').child($code).child('meta/hostUid').val() === auth.uid" },
            "botDifficulty": { ".write": "auth != null && root.child('games').child($code).child('meta/hostUid').val() === auth.uid" }
          }
        }
      }
    }
  }
}
